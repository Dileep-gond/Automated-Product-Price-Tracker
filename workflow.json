      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "# Get all input items\nitems = _items\n\n# Store minimum prices\nresult = {}\n\n# STEP 1:\n# Get latest date from FIRST row\n# (because newest records are added at top)\n\nfirst_row = items[0][\"json\"]\n\nlatest_date = str(first_row[\"time\"]).split(\"T\")[0]\n\n# STEP 2:\n# Loop from START\n\nfor item in items:\n\n    row = item[\"json\"]\n\n    # Skip invalid rows safely\n    if (\n        \"time\" not in row or\n        \"product\" not in row or\n        \"price\" not in row\n    ):\n        continue\n\n    # Extract row date\n    row_date = str(row[\"time\"]).split(\"T\")[0]\n\n    # Stop loop once date changes\n    if row_date != latest_date:\n        break\n\n    # Clean product name\n    product = str(row[\"product\"]).strip()\n\n    # Clean and convert price\n    try:\n\n        price = float(\n            str(row[\"price\"])\n            .replace(\",\", \"\")\n            .replace(\"₹\", \"\")\n            .strip()\n        )\n\n    except:\n        continue\n\n    # First occurrence\n    if product not in result:\n\n        result[product] = price\n\n    # Update minimum price\n    elif price < result[product]:\n\n        result[product] = price\n\n# STEP 3:\n# Convert to n8n output format\n\noutput = []\n\nfor product, min_price in result.items():\n\n    output.append({\n        \"json\": {\n            \"date\": latest_date,\n            \"product\": product,\n            \"min_price\": min_price\n        }\n    })\n\nreturn output"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
